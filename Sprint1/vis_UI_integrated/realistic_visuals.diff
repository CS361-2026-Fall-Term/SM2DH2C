+            for i, s in enumerate(segs):
+                if s[0] == cur[-1]:
+                    cur = cur + s[1:]
+                elif s[-1] == cur[-1]:
+                    cur = cur + s[::-1][1:]
+                elif s[-1] == cur[0]:
+                    cur = s[:-1] + cur
+                elif s[0] == cur[0]:
+                    cur = s[::-1][:-1] + cur
+                else:
+                    continue
+                segs.pop(i)
+                joined = True
+                break
+        if len(cur) >= 4 and cur[0] == cur[-1]:
+            rings.append(cur)
+    return rings
